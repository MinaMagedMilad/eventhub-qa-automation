# Copy to `.env` (git-ignored) and fill in. Every value can also be supplied as a real
# environment variable (that is how CI passes them, from GitHub Actions secrets).

# --- Target environment (defaults shown; override to point at another deployment) ---
EVENTHUB_BASE_URL=https://eventhub.rahulshettyacademy.com
EVENTHUB_API_URL=https://api.eventhub.rahulshettyacademy.com/api

# --- Primary test user (required) --------------------------------------------------
# A dedicated EventHub account used by almost every test.
EVENTHUB_PRIMARY_EMAIL=
EVENTHUB_PRIMARY_PASSWORD=

# --- Secondary test user (required for the authorization / tenant-isolation tests) ---
# A second, different EventHub account. Tests that need it are skipped if it is missing.
EVENTHUB_SECONDARY_EMAIL=
EVENTHUB_SECONDARY_PASSWORD=

# --- Optional tuning ------------------------------------------------------------------
# EVENTHUB_API_TIMEOUT_MS=20000
# EVENTHUB_UI_TIMEOUT_MS=15000

# --- Optional run identity / test data -------------------------------------------------
# Id stamped on every event title this run creates ("QA-AUTO <run id>-<worker> ...").
# Unset: generated per run (UTC timestamp + random). CI passes its own run number.
# EVENTHUB_RUN_ID=
# Seed every generated value (names, e-mails, phones, title suffixes) derives from. Unset: a new seed
# per run. It is printed in the report header ("eventhub data seed: ..."): set it here to replay the
# data of a failed run, e.g. EVENTHUB_DATA_SEED=123456789 pytest "<test id>".
# EVENTHUB_DATA_SEED=
